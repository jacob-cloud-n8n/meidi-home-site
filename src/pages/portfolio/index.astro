---
import MeidiLayout from "@layouts/MeidiLayout.astro";
import { c, fontSizeClass, getMeidiCaseProjects, getMeidiCopy, valueFontSizeClass } from "@lib/meidi";

const copy = await getMeidiCopy("portfolio");
const projects = await getMeidiCaseProjects();
const visibleCategories = [...new Set(projects.map((item) => item.category).filter(Boolean))];
const categories = ["全部案例", ...visibleCategories];
---

<MeidiLayout title="精選案例｜美地居家收納 Stitch 版" currentPath="/portfolio/">
  <main class="container">
    <header class="page-hero portfolio-hero">
      <span class="label">{c(copy, "portfolio.hero.label", "Case Study 收納案例")}</span>
      <h1 class={fontSizeClass(copy, "portfolio.hero.title", "display-size")}>{c(copy, "portfolio.hero.title", "用完整案例看見美地的整理方法。")}</h1>
      <p class:list={["lede", fontSizeClass(copy, "portfolio.hero.lede")]}>{c(copy, "portfolio.hero.lede", "每一個案例都先釐清亂源，再設計分區、動線與維護方式。公開照片皆以壓縮與浮水印處理，保護客戶隱私與服務成果。")}</p>
      <div class="filters" data-case-filters>
        {categories.map((category, index) => <button class:list={["filter", { active: index === 0 }]} type="button" data-category={category}>{category}</button>)}
      </div>
    </header>

    <section class="section portfolio-projects" aria-label="案例列表">
      <div class="case-project-grid" data-case-list>
        {projects.map((project) => (
          <article class="case-project-card" data-category={project.category}>
            <a class="case-project-cover" href={`/portfolio/${project.slug}/`}>
              {project.coverImage ? <img src={project.coverImage} alt={`${project.title} 封面`} loading="lazy" decoding="async" /> : <span>案例圖片待上傳</span>}
            </a>
            <div class="case-project-body">
              <span class="label">{project.status || project.category}</span>
              <h2 class={valueFontSizeClass(project.fontSize, "heading-size")}>{project.title}</h2>
              <p class={valueFontSizeClass(project.fontSize)}>{project.summary}</p>
              <div class="case-project-meta">
                <span>{project.category}</span>
                <span>{project.spaces.length} 個空間</span>
              </div>
              <a class="inline-link" href={`/portfolio/${project.slug}/`}>查看案例方法 <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <script>
    const filters = document.querySelector("[data-case-filters]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-case-list] [data-category]"));
    filters?.addEventListener("click", (event) => {
      const target = event.target instanceof HTMLElement ? event.target.closest<HTMLButtonElement>("[data-category]") : null;
      if (!target) return;
      const category = target.dataset.category || "全部案例";
      filters.querySelectorAll(".filter").forEach((button) => button.classList.toggle("active", button === target));
      cards.forEach((card) => {
        const matches = category === "全部案例" || card.dataset.category === category;
        card.hidden = !matches;
      });
    });
  </script>
</MeidiLayout>
