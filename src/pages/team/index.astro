---
import MeidiLayout from "@layouts/MeidiLayout.astro";
import { c, fontSizeClass, getMeidiArticles, getMeidiCopy, image, valueFontSizeClass } from "@lib/meidi";

const copy = await getMeidiCopy("team");
const articles = await getMeidiArticles();
---

<MeidiLayout title="收納大小事與整理心法專欄｜美地居家收納" description="瀏覽美地居家收納專欄，分享專業整理心法、收納技巧、線上諮詢與真實居家改善故事，幫助您建立有秩序的日常生活。" currentPath="/team/">
  <main class="container">
    <section class="stories-cover">
      <img src={image(copy, "team.stories.hero.image", "/assets/huali-portrait.jpg")} alt="收納大小事主視覺" />
      <div class="stories-cover-badge">{c(copy, "team.stories.hero.badge", "收納大小事")}</div>
    </section>

    <section class="stories-intro">
      <span class="label">{c(copy, "team.stories.label", "Relife Journal")}</span>
      <h1 class={fontSizeClass(copy, "team.stories.title", "display-size")}>{c(copy, "team.stories.title", "整理心法、服務消息與家的改變故事。")}</h1>
      <p class:list={["lede", fontSizeClass(copy, "team.stories.lede")]}>{c(copy, "team.stories.lede", "從收納觀點、線上諮詢到衣櫥與居家空間提案，透過一篇篇圖文讓你看見整理如何回到日常生活。")}</p>
    </section>

    <section class="section stories-section">
      <div class="story-grid">
        {articles.map((article) => (
          <a class="story-card" href={`/team/${article.slug}/`}>
            <div class="story-media">
              {article.image ? <img src={article.image} alt={`${article.title} 圖片`} loading="lazy" /> : <div class="story-placeholder">收納大小事</div>}
            </div>
            <div class="story-body">
              <div class="story-meta">{article.category}</div>
              <h2 class={valueFontSizeClass(article.fontSize, "heading-size")}>{article.title}</h2>
              <p class={valueFontSizeClass(article.fontSize)}>{article.excerpt}</p>
              <span class="inline-link">查看更多 <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</MeidiLayout>
