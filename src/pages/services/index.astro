---
import MeidiLayout from "@layouts/MeidiLayout.astro";
import { c, fontSizeClass, getMeidiCopy, getMeidiServices, imageSizeClass, valueFontSizeClass } from "@lib/meidi";

const copy = await getMeidiCopy("services");
const services = await getMeidiServices();
---

<MeidiLayout title="空間收納與規劃服務項目｜美地居家收納" description="美地居家收納提供居家收納、收納講座、收納品代買、搬家打包、空間診斷與全屋整理等六大專業空間規劃服務。" currentPath="/services/">
  <main class="container">
    <header class="page-hero"><span class="label">{c(copy, "services.hero.label", "空間分類系統")}</span><h1 class={fontSizeClass(copy, "services.hero.title", "display-size")}>{c(copy, "services.hero.title", "精準對接客戶痛點。")}</h1><p class:list={["lede", fontSizeClass(copy, "services.hero.lede")]}>{c(copy, "services.hero.lede", "透過分類標籤，讓客戶快速找到與自家相似的混亂情境，並理解美地可以協助的空間範圍。")}</p></header>
    <section class="section">
      <div class="service-grid">
        {services.map((service) => <article class="service-tile">{service.image ? <img class:list={["service-visual", imageSizeClass(service.imageSize)]} src={service.image} alt={`${service.title} 圖示`} loading="lazy" /> : <span class:list={["material-symbols-outlined", imageSizeClass(service.imageSize, "icon-size")]}>{service.icon}</span>}<h3 class={valueFontSizeClass(service.fontSize)}>{service.title}</h3><p class={valueFontSizeClass(service.fontSize)}>{service.body}</p></article>)}
      </div>
    </section>
  </main>
</MeidiLayout>
