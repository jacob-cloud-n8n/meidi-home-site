  <!-- 前端 JavaScript 邏輯 -->
  <script is:inline define:vars={{ lineUrl }}>
    document.addEventListener("DOMContentLoaded", () => {
      let currentStep = 1;
      const totalSteps = 3;
      
      const form = document.getElementById("diagnosisForm");
      const progressFill = document.getElementById("progressFill");
      const stepIndicators = document.querySelectorAll(".step-indicator");
      
      // 更新進度條
      function updateProgressBar(step) {
        // 更新進度條寬度
        const percentage = ((step - 1) / (totalSteps)) * 100;
        progressFill.style.width = `${percentage}%`;
        
        // 更新步驟標籤樣式
        stepIndicators.forEach((indicator) => {
          const stepNum = parseInt(indicator.getAttribute("data-step") || "1");
          if (stepNum <= step) {
            indicator.classList.add("active");
          } else {
            indicator.classList.remove("active");
          }
        });
      }

      // 步驟切換函數
      function goToStep(step) {
        document.querySelector(`.form-step.active`)?.classList.remove("active");
        document.getElementById(`step${step}`)?.classList.add("active");
        currentStep = step;
        updateProgressBar(step);
        window.scrollTo({ top: document.querySelector(".progress-bar-container")?.getBoundingClientRect().top + window.scrollY - 100, behavior: "smooth" });
      }

      // Step 1: 填寫人「其他」輸入框控制
      const parentRoleRadios = document.querySelectorAll('input[name="parentRole"]');
      const parentRoleOtherInput = document.getElementById("parentRoleOther");
      const roleOtherRadio = document.getElementById("roleOtherRadio");
      const roleOtherLabel = document.getElementById("roleOtherLabel");

      parentRoleRadios.forEach((radio) => {
        radio.addEventListener("change", () => {
          if (radio.value === "其他") {
            parentRoleOtherInput.disabled = false;
            parentRoleOtherInput.focus();
            parentRoleOtherInput.required = true;
          } else {
            parentRoleOtherInput.disabled = true;
            parentRoleOtherInput.value = "";
            parentRoleOtherInput.required = false;
          }
        });
      });

      // 點擊「其他」卡片時自動 focus
      roleOtherLabel?.addEventListener("click", () => {
        if (roleOtherRadio?.checked) {
          parentRoleOtherInput.disabled = false;
          parentRoleOtherInput.focus();
        }
      });

      // 寶貝 1 年齡自動帶入
      const baby1AgeGroup = document.getElementById("baby1AgeGroup");
      const baby1AgeInput = document.querySelector('input[name="baby1Age"]');

      baby1AgeGroup?.addEventListener("change", (e) => {
        const val = e.target.value;
        if (val === "幼幼班以下") {
          baby1AgeInput.value = "2";
        } else if (val === "小班/中班") {
          baby1AgeInput.value = "4";
        } else if (val === "大班") {
          baby1AgeInput.value = "6";
        } else if (val === "國小低年級") {
          baby1AgeInput.value = "8";
        } else {
          baby1AgeInput.value = "";
          baby1AgeInput.focus();
        }
      });

      // 寶貝 2 顯示/清除控制
      const baby2Gender = document.getElementById("baby2Gender");
      const baby2AgeGroup = document.getElementById("baby2AgeGroup");
      const baby2Age = document.getElementById("baby2Age");
      const btnClearBaby2 = document.getElementById("btnClearBaby2");

      function updateBaby2ClearButton() {
        if (baby2Gender?.value || baby2AgeGroup?.value || baby2Age?.value) {
          btnClearBaby2.style.display = "inline-block";
        } else {
          btnClearBaby2.style.display = "none";
        }
      }

      baby2Gender?.addEventListener("change", updateBaby2ClearButton);
      baby2AgeGroup?.addEventListener("change", updateBaby2ClearButton);
      baby2Age?.addEventListener("input", updateBaby2ClearButton);

      btnClearBaby2?.addEventListener("click", () => {
        if (baby2Gender) baby2Gender.value = "";
        if (baby2AgeGroup) baby2AgeGroup.value = "";
        if (baby2Age) baby2Age.value = "";
        btnClearBaby2.style.display = "none";
      });

      // 寶貝 2 年齡自動帶入
      baby2AgeGroup?.addEventListener("change", (e) => {
        const val = e.target.value;
        if (val === "幼幼班以下") {
          baby2Age.value = "2";
        } else if (val === "小班/中班") {
          baby2Age.value = "4";
        } else if (val === "大班") {
          baby2Age.value = "6";
        } else if (val === "國小低年級") {
          baby2Age.value = "8";
        } else {
          baby2Age.value = "";
          baby2Age.focus();
        }
        updateBaby2ClearButton();
      });

      // 頭痛空間「其他」輸入框控制
      const spaceOtherCheckbox = document.getElementById("spaceOtherCheckbox");
      const spaceOtherLabel = document.getElementById("spaceOtherLabel");
      const troubleSpaceOtherInput = document.getElementById("troubleSpaceOther");

      spaceOtherCheckbox?.addEventListener("change", () => {
        if (spaceOtherCheckbox.checked) {
          troubleSpaceOtherInput.disabled = false;
          troubleSpaceOtherInput.focus();
          troubleSpaceOtherInput.required = true;
        } else {
          troubleSpaceOtherInput.disabled = true;
          troubleSpaceOtherInput.value = "";
          troubleSpaceOtherInput.required = false;
        }
      });

      spaceOtherLabel?.addEventListener("click", () => {
        if (spaceOtherCheckbox?.checked) {
          troubleSpaceOtherInput.disabled = false;
          troubleSpaceOtherInput.focus();
        }
      });

      // 防止點擊「其他」文字輸入框時，因為事件冒泡觸發了 Label 的 click 事件，導致 checkbox 被取消或 Radio 被重置
      parentRoleOtherInput?.addEventListener("click", (e) => {
        e.stopPropagation();
      });
      troubleSpaceOtherInput?.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      // 表單按鈕點擊「下一步」
      document.querySelectorAll(".btn-next").forEach((btn) => {
        btn.addEventListener("click", () => {
          const nextStep = parseInt(btn.getAttribute("data-next") || "2");
          
          // 驗證當前步驟
          if (currentStep === 1) {
            // 驗證寶貝 1 資料是否齊全
            const genderVal = document.querySelector('select[name="baby1Gender"]').value;
            const ageGroupVal = document.querySelector('select[name="baby1AgeGroup"]').value;
            const ageVal = baby1AgeInput.value;
            
            if (!genderVal || !ageGroupVal || !ageVal) {
              form.reportValidity();
              return;
            }
            
            // 驗證頭痛空間多選，至少選一項
            const troubleSpaces = document.querySelectorAll('input[name="troubleSpace"]:checked');
            const spaceError = document.getElementById("spaceError");
            if (troubleSpaces.length === 0) {
              if (spaceError) spaceError.style.display = "block";
              return;
            } else {
              if (spaceError) spaceError.style.display = "none";
            }
            
            // 若選擇「其他」空間，必須填寫內容
            if (spaceOtherCheckbox?.checked && !troubleSpaceOtherInput.value.trim()) {
              troubleSpaceOtherInput.reportValidity();
              return;
            }
            // 若選擇「其他」稱呼，必須填寫內容
            if (roleOtherRadio?.checked && !parentRoleOtherInput.value.trim()) {
              parentRoleOtherInput.reportValidity();
              return;
            }
          }
          
          goToStep(nextStep);
        });
      });

      // 表單按鈕點擊「上一步」
      document.querySelectorAll(".btn-prev").forEach((btn) => {
        btn.addEventListener("click", () => {
          const prevStep = parseInt(btn.getAttribute("data-prev") || "1");
          goToStep(prevStep);
        });
      });

      // 診斷說明文案庫
      const zoneTexts = {
        green: `恭喜您！您和寶貝的空間非常有秩序！\n您的居家生活系統運作良好，孩子目前能順利適應現有秩序。只需微調局部的動線與收納技巧（例如調整換季衣物收納法、或是定期維持玩具淘汰機制），就能持續維持完美的親子空間。`,
        yellow: `注意！您家裡的收納工具可能「太複雜」或「高度不對」。\n孩子不是不收，而是遇到了物理上的困難。例如收納箱太深不方便拿、或者掛鉤太高夠不著。建議重新規劃「兒童直覺動線」，將常用物品降至孩子胸口以下的高度，並採用開放式、單一動作即可完成的收納工具，孩子就能大大提升自主整理的意願！`,
        red: `警告！空間混亂已經開始影響家人的情緒與孩子的自主學習！\n孩子在過多雜物與不明確的物品定位下，容易感到不知所措，進而放棄收拾；而家長也因反覆碎念累積了高額的心累指數。此階段非常需要整理專家的協助，透過「徹底篩選淘汰」與「重新建立生活動線規劃」，為您的家庭量身打造小孩好收、媽媽好教的舒心秩序。`
      };

      // 表單送出：計算診斷結果
      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        
        // 進入第 4 步 (顯示 Loading)
        goToStep(4);
        const loadingDiv = document.getElementById("diagnosisLoading");
        const resultDiv = document.getElementById("diagnosisResult");
        
        if (loadingDiv) loadingDiv.style.display = "block";
        if (resultDiv) resultDiv.style.display = "none";
        
        // 模擬 AI 運算大腦延遲（增加專業感與真實度）
        setTimeout(() => {
          if (loadingDiv) loadingDiv.style.display = "none";
          if (resultDiv) resultDiv.style.display = "block";
          
          // 1. 計算混亂分數
          const checkedConfusion = document.querySelectorAll('input[name="confusionItem"]:checked');
          const score = checkedConfusion.length;
          
          // 2. 決定分區與更新卡片樣式
          const resultScoreSpan = document.getElementById("resultScore");
          const resultCard = document.getElementById("resultCard");
          const resultZoneBadge = document.getElementById("resultZoneBadge");
          const resultDescText = document.getElementById("resultDescText");
          
          if (resultScoreSpan) resultScoreSpan.textContent = score.toString();
          
          // 清除舊 class
          resultCard?.classList.remove("zone-green", "zone-yellow", "zone-red");
          
          let zoneKey = "green";
          let zoneLabel = "【綠色安全區】";
          
          if (score <= 2) {
            zoneKey = "green";
            zoneLabel = "綠色安全區";
            resultCard?.classList.add("zone-green");
          } else if (score <= 5) {
            zoneKey = "yellow";
            zoneLabel = "黃色預警區";
            resultCard?.classList.add("zone-yellow");
          } else {
            zoneKey = "red";
            zoneLabel = "紅色緊繃區";
            resultCard?.classList.add("zone-red");
          }
          
          if (resultZoneBadge) resultZoneBadge.textContent = zoneLabel;
          if (resultDescText) resultDescText.textContent = zoneTexts[zoneKey];
          
          // 3. 填寫心靈溫度計與基本資訊
          const childIndependenceVal = document.querySelector('input[name="childIndependence"]:checked')?.value || "";
          const familyStandardVal = document.querySelector('input[name="familyStandard"]:checked')?.value || "";
          const motherStressVal = document.querySelector('input[name="motherStress"]:checked')?.value || "";
          
          const valIndependence = document.getElementById("valIndependence");
          const valStandard = document.getElementById("valStandard");
          const valStress = document.getElementById("valStress");
          
          if (valIndependence) valIndependence.textContent = childIndependenceVal;
          if (valStandard) valStandard.textContent = familyStandardVal;
          if (valStress) valStress.textContent = motherStressVal;
          
          // 4. 更新進度條為 100%
          updateProgressBar(4);
          
        }, 1800); // 1.8 秒延遲
      });

      // 重新填寫
      const btnRestart = document.getElementById("btnRestart");
      btnRestart?.addEventListener("click", () => {
        form.reset();
        parentRoleOtherInput.disabled = true;
        parentRoleOtherInput.value = "";
        troubleSpaceOtherInput.disabled = true;
        troubleSpaceOtherInput.value = "";
        if (btnClearBaby2) btnClearBaby2.style.display = "none";
        goToStep(1);
      });

      // Toast 提示函數
      function showToast(msg) {
        const toast = document.getElementById("toast");
        if (toast) {
          toast.textContent = msg;
          toast.classList.add("show");
          setTimeout(() => {
            toast.classList.remove("show");
          }, 2500);
        }
      }

      // 支援非 HTTPS/iOS/Android Fallback 的複製函數
      function copyToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        } else {
          return new Promise((resolve, reject) => {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.top = "0";
            textarea.style.left = "0";
            textarea.style.width = "2em";
            textarea.style.height = "2em";
            textarea.style.padding = "0";
            textarea.style.border = "none";
            textarea.style.outline = "none";
            textarea.style.boxShadow = "none";
            textarea.style.background = "transparent";
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            try {
              const successful = document.execCommand("copy");
              document.body.removeChild(textarea);
              if (successful) {
                resolve();
              } else {
                reject(new Error("複製失敗"));
              }
            } catch (err) {
              document.body.removeChild(textarea);
              reject(err);
            }
          });
        }
      }

      // 一鍵複製報告與加 LINE 預約
      const btnLineGift = document.getElementById("btnLineGift");
      btnLineGift?.addEventListener("click", () => {
        // 蒐集填寫的詳細資料
        const formData = new FormData(form);
        
        let parentRole = formData.get("parentRole");
        if (parentRole === "其他") {
          parentRole = `其他 (${document.getElementById("parentRoleOther")?.value || ""})`;
        }
        
        const baby1Gender = formData.get("baby1Gender");
        const baby1AgeGroup = formData.get("baby1AgeGroup");
        const baby1Age = formData.get("baby1Age");
        
        let babyInfo = `${baby1Gender} (${baby1AgeGroup} ${baby1Age}歲)`;
        
        const baby2GenderVal = formData.get("baby2Gender");
        const baby2AgeGroupVal = formData.get("baby2AgeGroup");
        const baby2AgeVal = formData.get("baby2Age");
        if (baby2GenderVal && baby2AgeGroupVal && baby2AgeVal) {
          babyInfo += `、寶貝 2：${baby2GenderVal} (${baby2AgeGroupVal} ${baby2AgeVal}歲)`;
        }
        
        // 收集頭痛空間
        const selectedSpaces = [];
        document.querySelectorAll('input[name="troubleSpace"]:checked').forEach((cb) => {
          if (cb.value === "其他") {
            selectedSpaces.push(`其他 (${document.getElementById("troubleSpaceOther")?.value || ""})`);
          } else {
            selectedSpaces.push(cb.value);
          }
        });
        const spacesText = selectedSpaces.join("、");
        
        // 得分與分區
        const score = document.getElementById("resultScore")?.textContent || "0";
        let zoneLabel = "綠色安全區";
        if (parseInt(score) <= 2) {
          zoneLabel = "綠色安全區 (0-2項符合)";
        } else if (parseInt(score) <= 5) {
          zoneLabel = "黃色預警區 (3-5項符合)";
        } else {
          zoneLabel = "紅色緊繃區 (6項以上符合)";
        }
        
        // 心靈溫度計
        const childIndependence = document.querySelector('input[name="childIndependence"]:checked')?.value || "";
        const familyStandard = document.querySelector('input[name="familyStandard"]:checked')?.value || "";
        const motherStress = document.querySelector('input[name="motherStress"]:checked')?.value || "";
        
        // 組合報告文字
        const reportText = `您好！我已完成美地居家收納的「親子居家空間健康診斷表」。
【填寫人】${parentRole}
【寶貝資訊】${babyInfo}
【頭痛空間】${spacesText}
【居家混亂得分】${score} 分 / 屬於【${zoneLabel}】
【親子收納心靈指標】
- 孩子自動自發：${childIndependence}
- 收納標準一致：${familyStandard}
- 媽媽心情負擔：${motherStress}

希望能預約小琍老師的【1對1 線上空間拍照診斷】！`;

        // 複製到剪貼簿 (具備相容性 Fallback)
        copyToClipboard(reportText).then(() => {
          showToast("📋 診斷報告已複製！正在跳轉官方 LINE...");
          
          // 1.5 秒後跳轉 LINE
          setTimeout(() => {
            window.location.href = lineUrl;
          }, 1500);
        }).catch((err) => {
          console.error("複製失敗:", err);
          showToast("❌ 複製失敗，即將為您開啟官方 LINE！");
          setTimeout(() => {
            window.location.href = lineUrl;
          }, 1000);
        });

      });

    });
  </script>
</MeidiLayout>
