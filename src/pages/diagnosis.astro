---
import MeidiLayout from "@layouts/MeidiLayout.astro";
import { lineUrl } from "@lib/meidi";
---

<MeidiLayout title="親子居家空間健康診斷表｜美地居家收納" description="家是溫暖的避風港，讓我們一起找出讓媽媽心累、寶貝不知所措的「空間盲點」吧！" currentPath="/diagnosis/">
  <main class="container py-diagnosis">
    <div class="diagnosis-wrapper">
      
      <!-- 頂部標題區 -->
      <header class="diagnosis-header text-center">
        <span class="label">親子空間診斷</span>
        <h1 class="diagnosis-title">親子居家空間健康診斷表</h1>
        <p class="diagnosis-subtitle">家是溫暖的避風港，讓我們一起找出讓媽媽心累、寶貝不知所措的「空間盲點」吧！</p>
      </header>

      <!-- 進度條 -->
      <div class="progress-bar-container">
        <div class="progress-steps">
          <span class="step-indicator active" data-step="1">1. 基本資料</span>
          <span class="step-indicator" data-step="2">2. 混亂指數</span>
          <span class="step-indicator" data-step="3">3. 心靈溫度</span>
          <span class="step-indicator" data-step="4">4. 診斷結果</span>
        </div>
        <div class="progress-line">
          <div class="progress-fill" id="progressFill"></div>
        </div>
      </div>

      <!-- 表單本體 -->
      <div class="diagnosis-card shadow">
        <form id="diagnosisForm">
          
          <!-- STEP 1: 家庭基本資料 -->
          <div class="form-step active" id="step1">
            <h2 class="step-title"><span class="material-symbols-outlined icon-align">family_restroom</span> 第一部分：家庭基本資料</h2>
            <p class="step-desc">填寫基本資料，以便小琍老師提供精準的居家診斷建議。</p>
            
            <div class="form-group">
              <label class="form-label">填寫人稱呼 <span class="required">*</span></label>
              <div class="radio-card-grid">
                <label class="radio-card">
                  <input type="radio" name="parentRole" value="媽咪" required checked />
                  <span class="radio-content">
                    <span class="radio-text">媽咪</span>
                  </span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="parentRole" value="爸爸" />
                  <span class="radio-content">
                    <span class="radio-text">爸爸</span>
                  </span>
                </label>
                <label class="radio-card" id="roleOtherLabel">
                  <input type="radio" name="parentRole" value="其他" id="roleOtherRadio" />
                  <span class="radio-content">
                    <span class="radio-text">其他</span>
                    <input type="text" id="parentRoleOther" class="inline-text-input" placeholder="請填寫..." disabled />
                  </span>
                </label>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">寶貝的年齡與性別（最多兩位） <span class="required">*</span></label>
              <div class="baby-info-container">
                <div class="baby-row">
                  <span class="baby-badge">寶貝 1</span>
                  <div class="baby-inputs">
                    <div class="select-wrapper">
                      <select name="baby1Gender" class="field" required>
                        <option value="" disabled selected>選擇性別</option>
                        <option value="女生">女生</option>
                        <option value="男生">男生</option>
                      </select>
                    </div>
                    <div class="select-wrapper">
                      <select name="baby1AgeGroup" id="baby1AgeGroup" class="field" required>
                        <option value="" disabled selected>選擇年齡層</option>
                        <option value="幼幼班以下">幼幼班以下</option>
                        <option value="小班/中班">小班/中班</option>
                        <option value="大班">大班</option>
                        <option value="國小低年級">國小低年級</option>
                        <option value="其他">其他 (自行填寫年齡)</option>
                      </select>
                    </div>
                    <input type="number" name="baby1Age" class="field compact-input" placeholder="年齡(歲)" min="0" max="18" required />
                  </div>
                </div>

                <div class="baby-row optional-row">
                  <div class="baby-row-header">
                    <span class="baby-badge secondary">寶貝 2（選填）</span>
                    <button type="button" class="btn-clear-baby" id="btnClearBaby2" style="display:none;">清除寶貝 2</button>
                  </div>
                  <div class="baby-inputs">
                    <div class="select-wrapper">
                      <select name="baby2Gender" id="baby2Gender" class="field">
                        <option value="" selected>選擇性別</option>
                        <option value="女生">女生</option>
                        <option value="男生">男生</option>
                      </select>
                    </div>
                    <div class="select-wrapper">
                      <select name="baby2AgeGroup" id="baby2AgeGroup" class="field">
                        <option value="" selected>選擇年齡層</option>
                        <option value="幼幼班以下">幼幼班以下</option>
                        <option value="小班/中班">小班/中班</option>
                        <option value="大班">大班</option>
                        <option value="國小低年級">國小低年級</option>
                        <option value="其他">其他 (自行填寫年齡)</option>
                      </select>
                    </div>
                    <input type="number" name="baby2Age" id="baby2Age" class="field compact-input" placeholder="年齡(歲)" min="0" max="18" />
                  </div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">目前家中最讓您頭痛的空間 <span class="required">*</span></label>
              <div class="checkbox-card-grid">
                <label class="checkbox-card">
                  <input type="checkbox" name="troubleSpace" value="客廳公共區" />
                  <span class="checkbox-content">
                    <span class="material-symbols-outlined">deck</span>
                    <span class="checkbox-text">客廳公共區</span>
                  </span>
                </label>
                <label class="checkbox-card">
                  <input type="checkbox" name="troubleSpace" value="兒童房/玩具區" />
                  <span class="checkbox-content">
                    <span class="material-symbols-outlined">smart_toy</span>
                    <span class="checkbox-text">兒童房/玩具區</span>
                  </span>
                </label>
                <label class="checkbox-card">
                  <input type="checkbox" name="troubleSpace" value="衣櫃衣物區" />
                  <span class="checkbox-content">
                    <span class="material-symbols-outlined">checkroom</span>
                    <span class="checkbox-text">衣櫃衣物區</span>
                  </span>
                </label>
                <label class="checkbox-card">
                  <input type="checkbox" name="troubleSpace" value="玄關鞋櫃" />
                  <span class="checkbox-content">
                    <span class="material-symbols-outlined">door_front</span>
                    <span class="checkbox-text">玄關鞋櫃</span>
                  </span>
                </label>
                <label class="checkbox-card" id="spaceOtherLabel">
                  <input type="checkbox" name="troubleSpace" value="其他" id="spaceOtherCheckbox" />
                  <span class="checkbox-content">
                    <span class="material-symbols-outlined">more_horiz</span>
                    <span class="checkbox-text">其他</span>
                    <input type="text" id="troubleSpaceOther" class="inline-text-input" placeholder="請填寫空間..." disabled />
                  </span>
                </label>
              </div>
              <p class="error-msg" id="spaceError" style="display:none;">請至少選擇一個頭痛空間</p>
            </div>

            <div class="step-actions text-right">
              <button type="button" class="button btn-next" data-next="2">進入第二部分：混亂指數 <span class="material-symbols-outlined">arrow_forward</span></button>
            </div>
          </div>

          <!-- STEP 2: 居家空間混亂指數 -->
          <div class="form-step" id="step2">
            <h2 class="step-title"><span class="material-symbols-outlined icon-align">analytics</span> 第二部分：居家空間混亂指數</h2>
            <p class="step-desc">請根據您家中的真實日常情境，勾選符合您家現狀的選項（多選）。</p>

            <div class="confusion-grid">
              <!-- A. 兒童玩具與遊戲區 -->
              <div class="confusion-section">
                <h3 class="confusion-section-title"><span class="material-symbols-outlined icon-align">toys</span> A. 兒童玩具與遊戲區</h3>
                <div class="confusion-items">
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="1" />
                    <div class="item-inner">
                      <span class="item-num">1</span>
                      <p class="item-desc">玩具沒有固定的家，每次收完不到半天又散落一地。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="2" />
                    <div class="item-inner">
                      <span class="item-num">2</span>
                      <p class="item-desc">玩具箱太深、太重或太高，孩子想拿底部的玩具時必須把整箱倒出來。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="3" />
                    <div class="item-inner">
                      <span class="item-num">3</span>
                      <p class="item-desc">家裡常出現「缺件的拼圖」、「壞掉的玩具」或「麥當勞贈品」，不知該不該丟。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                </div>
              </div>

              <!-- B. 書包與學校物品區 -->
              <div class="confusion-section">
                <h3 class="confusion-section-title"><span class="material-symbols-outlined icon-align">school</span> B. 書包與學校物品區</h3>
                <div class="confusion-items">
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="4" />
                    <div class="item-inner">
                      <span class="item-num">4</span>
                      <p class="item-desc">孩子的書包、餐袋、水壺回家後總是隨手放在地板、沙發或餐椅上。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="5" />
                    <div class="item-inner">
                      <span class="item-num">5</span>
                      <p class="item-desc">聯絡簿常常摺角，或是孩子出門前一秒才在慌亂尋找要簽名的通知單。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="6" />
                    <div class="item-inner">
                      <span class="item-num">6</span>
                      <p class="item-desc">課本、彩色筆、美勞作品混成一團，書桌幾乎沒有空間可以寫功課。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                </div>
              </div>

              <!-- C. 衣物與出門準備區 -->
              <div class="confusion-section">
                <h3 class="confusion-section-title"><span class="material-symbols-outlined icon-align">checkroom</span> C. 衣物與出門準備區</h3>
                <div class="confusion-items">
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="7" />
                    <div class="item-inner">
                      <span class="item-num">7</span>
                      <p class="item-desc">摺好的童裝一抽出來就整疊倒塌，或是衣服多到抽屜根本塞不進去。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="8" />
                    <div class="item-inner">
                      <span class="item-num">8</span>
                      <p class="item-desc">每天出門前像戰場，要花很多時間幫孩子找襪子、學校圍兜兜或外套。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                  <label class="confusion-item-card">
                    <input type="checkbox" name="confusionItem" value="9" />
                    <div class="item-inner">
                      <span class="item-num">9</span>
                      <p class="item-desc">衣櫃裡混雜著「已經穿不下」和「準備等以後穿」的恩典牌衣服。</p>
                      <div class="custom-check"></div>
                    </div>
                  </label>
                </div>
              </div>
            </div>

            <div class="step-actions flex-between">
              <button type="button" class="button secondary btn-prev" data-prev="1"><span class="material-symbols-outlined">arrow_back</span> 回上一步</button>
              <button type="button" class="button btn-next" data-next="3">進入第三部分：心靈溫度計 <span class="material-symbols-outlined">arrow_forward</span></button>
            </div>
          </div>

          <!-- STEP 3: 親子收納習慣與心靈溫度計 -->
          <div class="form-step" id="step3">
            <h2 class="step-title"><span class="material-symbols-outlined icon-align">thermostat</span> 第三部分：親子收納習慣與心靈溫度計</h2>
            <p class="step-desc">此部分為加深診斷，請選擇最符合您家庭目前真實狀況的頻率或標準。</p>

            <div class="metric-list">
              <!-- 孩子自動自發度 -->
              <div class="metric-item">
                <div class="metric-header">
                  <span class="metric-title">孩子自動自發度</span>
                  <p class="metric-question">孩子在被提醒後，能夠自己把玩具或書包收到「對的位置」嗎？</p>
                </div>
                <div class="radio-card-grid three-options">
                  <label class="radio-card">
                    <input type="radio" name="childIndependence" value="經常可以" required checked />
                    <span class="radio-content text-center">
                      <span class="radio-text">經常可以</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="childIndependence" value="偶爾可以" />
                    <span class="radio-content text-center">
                      <span class="radio-text">偶爾可以</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="childIndependence" value="幾乎沒辦法" />
                    <span class="radio-content text-center">
                      <span class="radio-text">幾乎沒辦法</span>
                    </span>
                  </label>
                </div>
              </div>

              <!-- 收納標準一致度 -->
              <div class="metric-item">
                <div class="metric-header">
                  <span class="metric-title">收納標準一致度</span>
                  <p class="metric-question">全家人（爸爸、媽媽、阿公阿嬤等）對物品的「收納位置」標準一致嗎？</p>
                </div>
                <div class="radio-card-grid three-options">
                  <label class="radio-card">
                    <input type="radio" name="familyStandard" value="標準相同" required checked />
                    <span class="radio-content text-center">
                      <span class="radio-text">標準相同</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="familyStandard" value="各收各的" />
                    <span class="radio-content text-center">
                      <span class="radio-text">各收各的</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="familyStandard" value="常為此吵架" />
                    <span class="radio-content text-center">
                      <span class="radio-text">常為此吵架</span>
                    </span>
                  </label>
                </div>
              </div>

              <!-- 媽媽的心情負擔 -->
              <div class="metric-item">
                <div class="metric-header">
                  <span class="metric-title">媽媽的心情負擔</span>
                  <p class="metric-question">看著滿地的雜物，會忍不住對孩子碎念、血壓飆高，感覺家務壓力都在自己身上嗎？</p>
                </div>
                <div class="radio-card-grid three-options">
                  <label class="radio-card">
                    <input type="radio" name="motherStress" value="每天都會" required checked />
                    <span class="radio-content text-center">
                      <span class="radio-text">每天都會</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="motherStress" value="偶爾煩躁" />
                    <span class="radio-content text-center">
                      <span class="radio-text">偶爾煩躁</span>
                    </span>
                  </label>
                  <label class="radio-card">
                    <input type="radio" name="motherStress" value="心平氣和" />
                    <span class="radio-content text-center">
                      <span class="radio-text">心平氣和</span>
                    </span>
                  </label>
                </div>
              </div>
            </div>

            <div class="step-actions flex-between" style="margin-top: 40px;">
              <button type="button" class="button secondary btn-prev" data-prev="2"><span class="material-symbols-outlined">arrow_back</span> 回上一步</button>
              <button type="submit" class="button btn-submit"><span class="material-symbols-outlined">insights</span> 計算診斷結果</button>
            </div>
          </div>

          <!-- STEP 4: 診斷結果頁面 -->
          <div class="form-step" id="step4">
            
            <!-- 載入中動畫 -->
            <div class="loading-state text-center" id="diagnosisLoading">
              <div class="spinner"></div>
              <h3 class="loading-text">美地空間大腦分析中...</h3>
              <p class="loading-sub">小琍老師正在幫您盤點家中的收納黑洞，請稍候</p>
            </div>

            <!-- 真正結果顯示區 -->
            <div id="diagnosisResult" class="result-container" style="display:none;">
              
              <!-- 頂部診斷卡 -->
              <div class="result-card" id="resultCard">
                <div class="result-badge" id="resultZoneBadge">紅色緊繃區</div>
                <div class="result-score-block">
                  <span class="result-score-label">居家空間混亂指數</span>
                  <h2 class="result-score-val"><span id="resultScore">0</span> <span class="score-total">/ 9 項符合</span></h2>
                </div>
                
                <hr class="result-divider" />
                
                <div class="result-desc-block">
                  <h3 class="result-subtitle">🔍 空間現況診斷</h3>
                  <p class="result-desc-text" id="resultDescText"></p>
                </div>
              </div>

              <!-- 親子習慣回饋 -->
              <div class="habit-feedback-card">
                <h3 class="habit-title"><span class="material-symbols-outlined icon-align">favorite</span> 親子收納習慣反思</h3>
                <div class="habit-indicators">
                  <div class="habit-indicator">
                    <span class="habit-indicator-label">孩子自動自發</span>
                    <span class="habit-indicator-val" id="valIndependence">偶爾可以</span>
                  </div>
                  <div class="habit-indicator">
                    <span class="habit-indicator-label">家庭標準對齊</span>
                    <span class="habit-indicator-val" id="valStandard">各收各的</span>
                  </div>
                  <div class="habit-indicator">
                    <span class="habit-indicator-label">媽媽心情指數</span>
                    <span class="habit-indicator-val" id="valStress">每天都會</span>
                  </div>
                </div>
                <p class="habit-quote">「收納不是勞動，是我們給孩子最溫柔的自主權教育。」—— 小琍老師</p>
              </div>

              <!-- 幸福好禮引流卡 -->
              <div class="gift-card">
                <div class="gift-gift-badge">✨ 專屬完成好禮 ✨</div>
                <h2 class="gift-title">預約 1對1 免費線上空間診斷</h2>
                <p class="gift-text">凡完成此線上診斷的社區媽咪，即可憑此診斷結果免費預約由小琍老師親自進行的<strong>【1對1 線上空間拍照診斷（限時 20 分鐘）】</strong>，幫您精準找出家中的收納黑洞！</p>
                
                <div class="gift-steps">
                  <div class="gift-step-item">
                    <span class="gift-step-num">1</span>
                    <span>點擊下方按鈕，系統將自動複製您的診斷報告並開啟官方 LINE。</span>
                  </div>
                  <div class="gift-step-item">
                    <span class="gift-step-num">2</span>
                    <span>加入 LINE 後在對話框直接「貼上」並送出，即可完成免費預約登記！</span>
                  </div>
                </div>

                <div class="gift-actions text-center">
                  <button type="button" class="button btn-line-gift" id="btnLineGift">
                    <span class="material-symbols-outlined">content_copy</span>
                    <span>一鍵複製報告並加 LINE 預約</span>
                  </button>
                  <p class="line-id-fallback">官方 LINE 帳號：<strong>@meidi_organize</strong></p>
                </div>
              </div>

              <!-- 重新測驗 -->
              <div class="text-center" style="margin-top: 30px;">
                <button type="button" class="button secondary" id="btnRestart">
                  <span class="material-symbols-outlined">restart_alt</span> 重新填寫診斷表
                </button>
              </div>

            </div>
          </div>

        </form>
      </div>

    </div>
  </main>

  <!-- Toast 提示組件 -->
  <div class="toast" id="toast" aria-live="polite">已複製診斷報告！</div>

  <style>
    /* 診斷表專屬樣式 */
    .py-diagnosis {
      padding: 60px 0 100px;
    }
    .diagnosis-wrapper {
      width: min(800px, calc(100% - 32px));
      margin: 0 auto;
    }
    .diagnosis-header {
      margin-bottom: 40px;
    }
    .diagnosis-title {
      font-size: clamp(28px, 4.5vw, 42px);
      margin-top: 15px;
      margin-bottom: 12px;
      font-weight: 800;
    }
    .diagnosis-subtitle {
      color: var(--muted);
      font-size: clamp(15px, 2vw, 17px);
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }
    
    /* 進度條樣式 */
    .progress-bar-container {
      margin-bottom: 35px;
      position: relative;
    }
    .progress-steps {
      display: flex;
      justify-content: space-between;
      position: relative;
      z-index: 2;
    }
    .step-indicator {
      background: var(--surface-low);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: clamp(12px, 1.8vw, 14px);
      font-weight: 700;
