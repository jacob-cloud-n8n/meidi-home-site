---
import MeidiLayout from "@layouts/MeidiLayout.astro";
---

<MeidiLayout title="找不到頁面｜美地居家收納" description="這個頁面不存在或已移動。" currentPath="/404/">
  <main class="container">
    <section class="section text-center">
      <span class="label">404</span>
      <h1>找不到這個頁面</h1>
      <p>網址可能已更新，請回到首頁或重新選擇內容。</p>
      <a class="button primary" href="/">回到首頁</a>
    </section>
  </main>
</MeidiLayout>
